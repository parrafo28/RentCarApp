@model StatusViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Status</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <input type="hidden" id="modelId" />
        <div class="form-group">
            <label class="control-label"> Status Name</label>
            <input id="name" class="form-control" />
        </div>

        <div class="form-group">
            <button onclick="saveStatus()" class="btn btn-primary">SAve</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () { 
              loadDetails(@Model.Id);
        });

        function loadDetails(id) {
            $.get(`https://localhost:7252/Status/Get/${id}`, function (data) {
                $("#name").val(data.name);
                $("#modelId").val(data.id);
            });
        }

        function saveStatus() {
            let statusObj = {
                id: $("#modelId").val(),
                name: $("#name").val()
            };

            $.ajax({
                url: "https://localhost:7252/Status/Update",
                type: "PUT",
                contentType: "application/json",
                data: JSON.stringify(statusObj),
                success: function (response) {
                    if (response.success) {
                        window.location.href = "/Status/Index";
                    } else {
                        alert("Error: " + response.message);
                    }
                }
            });
        }
    </script>
}